# Cấu hình cổng phía Host (máy chủ thật)
HOST_PORT_HTTP=8088
HOST_PORT_HTTPS=8443
HOST_PORT_APP=5000
HOST_PORT_DB=5433
HOST_PORT_PGADMIN=5050

# Cấu hình Node.js Web App
PORT=5000
NODE_ENV=production

# Cấu hình PostgreSQL Database
DB_HOST=db
DB_PORT=5432
DB_NAME=nhahang_db
DB_USER=nhahang_user
DB_PASSWORD=your_secure_password_here

# Cấu hình pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password_here
